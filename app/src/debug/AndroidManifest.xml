<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: merged into the debug variant, never into release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Test trigger for class notifications. DUMP is held only by adb
             (shell) and the system, so no other app can fire it. -->
        <receiver
            android:name=".debug.DebugReminderReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.myiulms.debug.TEST_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Prints cached timetable identifiers (adb only, via DUMP). -->
        <receiver
            android:name=".debug.DebugScheduleDumpReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.myiulms.debug.DUMP_SCHEDULE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
